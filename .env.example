# Modelo de configuração. NÃO precisa copiar à mão:
#   docker compose up -d --build   cria o .env automaticamente a partir deste arquivo,
# gerando senhas e chaves aleatórias onde houver "troque_..." ou "cole_aqui...".
#
# O .env real fica na raiz do repositório, está no .gitignore e nunca vai para o GitHub.
# Ele é usado pelo Docker, pelo backend (npm run dev), pelo simulador e pelo MATLAB.

# ---------- PostgreSQL (usuários, comandos, logs) ----------
DB_HOST=localhost
# Porta no seu computador. 5433 evita conflito com um PostgreSQL já instalado no sistema.
DB_PORT=5433
DB_USER=pi_user
DB_PASSWORD=troque_esta_senha
DB_NAME=projeto_integrador

# ---------- InfluxDB 3 Core (séries temporais da planta) ----------
INFLUX_URL=http://localhost:8181
INFLUX_DB=planta
INFLUX_TOKEN=cole_aqui_o_token_do_influxdb

# ---------- Servidor ----------
PORT=3000

# Autenticação dos usuários do site (passo 4)
JWT_SECRET=troque_por_um_valor_aleatorio

# Chave AES-256 de leituras, comandos e logs (64 caracteres hex).
# ATENÇÃO: se for perdida ou trocada, os dados já gravados não podem mais ser lidos.
ENCRYPTION_KEY=troque_por_64_caracteres_hex

# Chave que o MATLAB (ou o simulador) envia no header X-Device-Key
DEVICE_KEY=troque_por_uma_chave_do_dispositivo
