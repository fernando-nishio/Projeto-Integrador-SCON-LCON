# Copie este arquivo para .env (na raiz do repo e em backend/) e troque os valores.
# O arquivo .env real está no .gitignore e nunca deve ir para o GitHub.

# ---------- PostgreSQL (usuários, comandos, logs) ----------
DB_HOST=localhost
# Porta no seu computador. 5433 evita conflito com um PostgreSQL já instalado no sistema.
DB_PORT=5433
DB_USER=pi_user
DB_PASSWORD=troque_esta_senha
DB_NAME=projeto_integrador

# ---------- InfluxDB 3 Core (séries temporais da planta) ----------
INFLUX_URL=http://localhost:8181
INFLUX_DB=planta
# Gere com: docker exec -it pi_influxdb influxdb3 create token --admin
INFLUX_TOKEN=cole_aqui_o_token_do_influxdb

# ---------- Servidor ----------
PORT=3000

# JWT (autenticação dos usuários do site — passo 4)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio

# Chave AES-256 para criptografar leituras, comandos e logs (32 bytes em hex = 64 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=troque_por_64_caracteres_hex

# Chave que o MATLAB (ou o simulador) envia no header X-Device-Key
# Gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DEVICE_KEY=troque_por_uma_chave_do_dispositivo
