# Copie este arquivo para .env (na raiz do repo e em backend/) e troque os valores.
# O arquivo .env real está no .gitignore e nunca deve ir para o GitHub.

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=pi_user
DB_PASSWORD=troque_esta_senha
DB_NAME=projeto_integrador

# Servidor
PORT=3000

# JWT (autenticação dos usuários do site)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_valor_aleatorio

# Chave AES-256 para criptografar as leituras (32 bytes em hex = 64 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=troque_por_64_caracteres_hex

# Chave que o ESP32 envia no header X-Device-Key
DEVICE_KEY=troque_por_uma_chave_do_dispositivo
